# Backend API base URL (Express Orchestrator)
# Default is http://localhost:3000
VITE_API_BASE_URL=http://localhost:3000

# Optional: Default Scenario to load on startup
VITE_DEFAULT_SCENARIO_ID=blr-2022-09-replay

# Polling interval for run status (milliseconds)
VITE_POLL_INTERVAL_MS=2000

# CARTO Basemap API Key
VITE_CARTO_API_KEY=your_carto_api_key_here
