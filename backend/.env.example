# HTTP port for the Express backend
PORT=3000

# Browser origin allowed to call the API
FRONTEND_ORIGIN=http://localhost:5173

# Base URL for the deterministic Python simulator
SIMULATOR_BASE_URL=http://127.0.0.1:8000

# Maximum time allowed for one simulator request, including its response body
SIMULATOR_TIMEOUT_MS=5000

# Shared demo bearer token required for approval and sandbox execution.
# Replace this placeholder through the process environment; never commit a real token.
OPERATOR_AUTH_TOKEN=replace-with-a-long-random-demo-token

# Server-side identity recorded in approval and sandbox audit entries
CONTROL_ROOM_OPERATOR=Control Room Operator
